# Copy to .env (gitignored). ameriflux-mcp does NOT auto-load .env; source it explicitly:
#   set -a; . ./.env; set +a
#
# None of these are needed to search sites, check availability, describe variables or
# get citations. They are used only by amf_download_data (stdio only, from build step 7),
# and everything below is SENT TO THE SITE PIs and the AmeriFlux download log when you
# confirm a download. Write the description yourself; never let an agent fill it in.
#
# Your AmeriFlux account user ID and email (create an account at https://amfcdn.lbl.gov/create).
AMERIFLUX_USER_ID=
AMERIFLUX_USER_EMAIL=
AMERIFLUX_USER_NAME=
# Intended use, 1-6: 1 multi-site synthesis, 2 land/Earth system model, 3 remote sensing,
# 4 other research, 5 education, 6 other.
AMERIFLUX_INTENDED_USE=
# How you plan to use the data (20-1000 characters); " [ameriflux-mcp]" is appended.
AMERIFLUX_DESCRIPTION=
# Required before any download: true for a test request, false for a real one. No default.
AMERIFLUX_MCP_IDENTITY__IS_TEST=
